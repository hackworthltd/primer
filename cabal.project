index-state: 2026-11-07T22:48:03Z
jobs: $ncpus
packages:
  primer
  primer-api
  primer-miso
  primer-benchmark

-- For fast local iteration. This only affects our own packages, since dependencies come pre-built from Nix.
-- Nix builds (for CI and deployment) ignore this, and use `-O2` for everything: see `configureFlags` in `flake.nix`.
optimization: 0

if arch(wasm32)
  -- The Wasm GHCi (as used by `make dev` in `primer-miso`) loads compiled libraries via the dynamic linker,
  -- so ours need to be built as shared libraries, just as Nix builds our dependencies.
  shared: True
  -- Avoids a C++ dynamic linker error.
  -- Cabal currently picks the installed `text` (from Nix) regardless, so this is just a safeguard.
  constraints:
    text installed,

  haddock-hoogle: False
  haddock-html: False
  haddock-quickjump: False
  haddock-hyperlink-source: False
  haddock-internal: False
else
  haddock-hoogle: True
  haddock-html: True
  haddock-quickjump: True
  haddock-hyperlink-source: True
  haddock-internal: True

  package *
    ghc-options: -fwrite-ide-info

benchmarks: True
tests: True
-- https://github.com/hedgehogqa/haskell-hedgehog-classes/pull/65
allow-newer: hedgehog-classes:base, hedgehog-classes:containers, hedgehog-classes:hedgehog
-- https://github.com/protolude/protolude/pull/153
allow-newer: protolude:base, protolude:containers

package primer
  test-options: "--size-cutoff=32768"

package primer-api
  test-options: "--size-cutoff=32768"

package miso
  flags: +aeson

-- PROTOTYPE: we use `georgefst`'s branch of `diagrams-svg`, with animation support
-- (https://github.com/diagrams/diagrams-svg/pull/127).
-- The branch predates the bounds relaxations of the 1.5.1 release, hence the `allow-newer`.
source-repository-package
  type: git
  location: https://github.com/georgefst/diagrams-svg
  tag: 0d8517ac3713444a1e42a6a68c616dfa8e524b6d
  --sha256: sha256-vwJ/oIaIBeM0EobUezjTJOaqrj/8YFiChkc0Bzn5Uno=
allow-newer: diagrams-svg:base, diagrams-svg:containers, diagrams-svg:diagrams-lib

-- PROTOTYPE: `diagrams` depends on `zlib` (via `JuicyPixels`), and our native dev shell doesn't provide its C library.
-- The Wasm build always uses the bundled C sources anyway.
package zlib
  flags: +bundled-c-zlib
