index-state: 2026-11-07T22:48:03Z
jobs: $ncpus
packages:
  primer
  primer-api
  primer-miso
  primer-benchmark

-- For fast local iteration. This only affects our own packages, since dependencies come pre-built from Nix.
-- Nix builds (for CI and deployment) ignore this, and use `-O2` for everything: see `configureFlags` in `flake.nix`.
optimization: 0

if arch(wasm32)
  -- Required for TemplateHaskell support on Wasm targets.
  shared: True
  -- Avoids a C++ dynamic linker error.
  constraints:
    text installed,

  haddock-hoogle: False
  haddock-html: False
  haddock-quickjump: False
  haddock-hyperlink-source: False
  haddock-internal: False
else
  haddock-hoogle: True
  haddock-html: True
  haddock-quickjump: True
  haddock-hyperlink-source: True
  haddock-internal: True

  package *
    ghc-options: -fwrite-ide-info

benchmarks: True
tests: True
-- https://github.com/hedgehogqa/haskell-hedgehog-classes/pull/65
allow-newer: hedgehog-classes:base, hedgehog-classes:containers, hedgehog-classes:hedgehog
-- https://github.com/protolude/protolude/pull/153
allow-newer: protolude:base, protolude:containers

package primer
  test-options: "--size-cutoff=32768"

package primer-api
  test-options: "--size-cutoff=32768"

package miso
  flags: +aeson
